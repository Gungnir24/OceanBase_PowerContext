# ---------------------------------------------------------------------------
# SDD 上下文模块配置示例
# 复制成 .env 后按需修改。不要把真实密钥提交到仓库。
# ---------------------------------------------------------------------------

# 上下文模块 —— 工程名（seekdb 里 documents.project 的取值）
SDDCTX_PROJECT=catalog

# seekdb（MySQL 协议；docker compose 默认暴露 2881）
SEEKDB_HOST=127.0.0.1
SEEKDB_PORT=2881
SEEKDB_USER=root
SEEKDB_PASSWORD=
SEEKDB_DATABASE=sddctx

# PowerContext Server
POWERCONTEXT_URL=http://127.0.0.1:8000
# 服务端开启鉴权时才需要
POWERCONTEXT_TOKEN=
# 留空则自动创建，并写入 .state/powercontext-scope.json
POWERCONTEXT_SCOPE_ID=
POWERCONTEXT_SCOPE_TITLE="SDD 上下文 · 商品目录检索"

# MiniMax（OpenAI 兼容网关；模型名即 MiniMax 官方模型 ID）
MINIMAX_BASE_URL=https://api.ppio.com/openai/v1
MINIMAX_API_KEY=<your-minimax-token>
MINIMAX_MODEL=minimax/minimax-m2.5
MINIMAX_TEMPERATURE=0.2
MINIMAX_MAX_TOKENS=8000
MINIMAX_TIMEOUT=300
