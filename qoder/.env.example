# ---------------------------------------------------------------------------
# 研栖 ResearchNest 配置示例
# 复制为 .env 后修改；不要把真实密钥提交到仓库。
# ---------------------------------------------------------------------------

# 应用
APP_HOST=127.0.0.1
APP_PORT=8787
# 演示模式：true 时使用内存数据，不连接 seekdb / PowerContext（只用于预览界面）
APP_DEMO=false
# 可选：把 .state（scope 与调用日志）放到别处
# APP_STATE_DIR=./.state

# seekdb（MySQL 协议）
SEEKDB_HOST=127.0.0.1
SEEKDB_PORT=2881
SEEKDB_USER=root
SEEKDB_PASSWORD=
SEEKDB_DATABASE=test
# 中文全文索引解析器：ik（推荐）/ ngram / 留空使用默认
SEEKDB_FTS_PARSER=ik

# 向量维度。默认本地哈希向量 384 维；换成 1024 维模型时需要重建表与索引。
EMBEDDING_DIM=384
# local = 零依赖哈希向量；openai = 任意 OpenAI 兼容 /embeddings 接口
EMBEDDING_PROVIDER=local
EMBEDDING_BASE_URL=https://api.openai.com/v1
EMBEDDING_API_KEY=
EMBEDDING_MODEL=text-embedding-3-small

# 检索参数
RETRIEVAL_TOP_K_VECTOR=12
RETRIEVAL_TOP_K_FTS=12
RETRIEVAL_RRF_K=60

# PowerContext Server
POWERCONTEXT_URL=http://127.0.0.1:8000
# 服务端开启鉴权时才需要
POWERCONTEXT_TOKEN=
# 留空则自动创建并写入 .state/powercontext-scope.json
POWERCONTEXT_SCOPE_ID=
POWERCONTEXT_SCOPE_TITLE="研栖 · 科研工作台"

# 可选：OpenAI 兼容的生成模型；不配置时使用抽取式回答
LLM_BASE_URL=https://api.openai.com/v1
LLM_API_KEY=
LLM_MODEL=gpt-4o-mini
LLM_TIMEOUT=60
